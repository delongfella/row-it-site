---
import Base from '../layouts/Base.astro';
// Web3Forms public access key (safe to keep in the page).
const WEB3FORMS_KEY = '88f97e74-8b36-465c-bdda-b17ba4c38392';
---
<Base
  title="Contact & Book a Coaching Session – Rohit Kumar"
  description="Book a discovery call or coaching session with Rohit Kumar, pilot-trainer and ICF-trained coach, or send a message to get in touch."
  breadcrumbs={[{ name: 'Contact', path: '/contact/' }]}
>
  <div class="wrap page-body">
    <h1 class="page-title">contact me</h1>
    <p class="lead">Welcome to a world of limitless possibilities, where the journey is as exhilarating as the destination, and where every moment is an opportunity to make your mark on the canvas of existence. The only limit is the extent of your imagination.</p>
    <p style="text-align:center;margin-top:1.75rem">
      <a class="btn" href="https://topmate.io/rowit" target="_blank" rel="noopener">Book a session here</a>
    </p>
    <p class="or">or</p>
    <h2 style="text-align:center;margin-top:0.5rem">Get in touch</h2>

    <form class="form" id="contact-form" name="contact" method="POST" action="https://api.web3forms.com/submit">
      <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
      <input type="hidden" name="subject" value="New message from row-it.in" />
      <input type="hidden" name="from_name" value="row-it.in contact form" />
      <p class="hp"><label>Leave this empty <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" /></label></p>
      <label><span>Name <span class="req">(required)</span></span>
        <input type="text" name="name" required autocomplete="name" />
      </label>
      <label><span>Email <span class="req">(required)</span></span>
        <input type="email" name="email" required autocomplete="email" />
      </label>
      <label>Phone
        <input type="tel" name="phone" autocomplete="tel" />
      </label>
      <label>How did you hear about us?
        <select name="source">
          <option value="">Select one option</option>
          <option>Search engine</option>
          <option>Social media</option>
          <option>Friend or family</option>
          <option>Other</option>
        </select>
      </label>
      <label>Message
        <textarea name="message"></textarea>
      </label>
      <button class="btn" type="submit">Send</button>
      <p id="form-status" role="status" style="text-align:center;margin:0.75rem 0 0"></p>
    </form>
  </div>
<script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('form-status');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
      btn.disabled = true;
      if (status) status.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const data = await res.json();
        if (data.success) { window.location.href = '/thank-you/'; return; }
        throw new Error(data.message || 'Failed');
      } catch (err) {
        if (status) status.textContent = 'Sorry, something went wrong. Please try again, or book a session on Topmate.';
        btn.disabled = false;
      }
    });
  </script>
</Base>
